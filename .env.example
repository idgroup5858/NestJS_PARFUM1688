# NestJS_NYFF — 3000; bir vaqtda ishlasa to'qnashmasin
PORT=3001
# Sana kalitlari (prixod / chiqim sanasi, "bugun"), yetkazish soatlari va hisobotlar shu vaqt zonasida
TZ=Asia/Tashkent

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=parfum1688

# Kamida 32 belgili tasodifiy satr. Bo'sh qolsa birinchi ishga tushishda avtomatik yaratiladi (bazada saqlanadi).
JWT_SECRET=
# PIN kodlar xeshi kaliti (HMAC). Bazadan TASHQARIDA turgani yaxshi: baza o'g'irlansa ham 4 xonali PIN'ni tanlab
# topib bo'lmaydi. Bo'sh qolsa — bazada yaratiladi. DIQQAT: o'rnatilgandan keyin almashtirilsa, barcha PIN'lar
# ishlamay qoladi (admin ularni qayta kiritadi).
PIN_SECRET=

# Ruxsat etilgan manbalar (vergul bilan). Bo'sh — hammasi (ishlab chiqish uchun).
# CORS_ORIGIN=http://localhost:5173

# 1 — demo rejimi: bo'sh bazaga demo ma'lumot (katalog + 30 kunlik savdo tarixi) yoziladi, admin
# "Demo ma'lumotlarni tiklash" ishlaydi. Haqiqiy do'konda 0 — bo'sh bazaga faqat katalog va xodimlar yoziladi.
DEMO=1

# off — Telegram bot (long polling va xabarnomalar) o'chiq. Testlar uchun.
# TELEGRAM=off

# off — IP bo'yicha urinishlar chegarasi o'chiq (PIN bilan kirish, mijoz buyurtmasi). Faqat testlar uchun.
# THROTTLE=off

# Atir / nota / kategoriya / banner / flakon rasmlari (`/images/...`). Standart — shu loyihaning uploads papkasi
# (seed'dagi "perfumes/dior-sauvage.png" kabi yo'llar shu papkaga nisbatan). Admin yuklagan rasm ham shu yerga.
# Serverda kod papkasidan tashqarida turgani yaxshi — yangilanishda yuklangan rasmlar o'chib ketmaydi:
# IMAGES_DIR=/var/parfum1688/uploads

# Tayyor web ilova (`npm run build` → dist). Papka bo'lmasa UI berilmaydi, faqat API (ishlab chiqishda UI — Vite, 5173).
# UI_DIST=../ReactJS_PARFUM1688/dist
